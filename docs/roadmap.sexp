  (:id "later" :type :roadmap :title "After the first build"
   :rows (
     ("later-m3" "The M3 Ultra tuning: decode steps on the non-tensor kernels" :later t)
     ("later-dspark" "Speculative decoding with Inkling's own DSpark drafter, exact verification: more tokens per cache read at long context" :later t)
     ("later-attention" "One attention kernel for every span, split over keys at positions fixed by the cache: decode spans near bus speed, bit-identical to prefill; gate on reference agreement, one reviewed golden rebaseline and bit-identical batch paths" :later t)
     ("later-fixed-cost" "A kernel for decode-size batches that reads each touched expert once at full bandwidth: up to 2x at 16 to 32 lanes" :later t)
     ("later-prefix-spec" "Shared-prefix design and measured overlap on four concurrent cards" :later t)
     ("later-prefix-model" "Gate: TLC exhausts BlockLayout grouping and CacheScheduler ownership; each reversed witness fails" :later t)
     ("later-prefix-storage" "Gate for layer-3 blocks and tables: poisoned-slot forks reproduce private K/V bytes and CI validates ownership traces before storage locks" :later t)
     ("later-prefix-reads" "Grouped prefix reads match private fixed-split logits and goldens bit for bit" :later t)
     ("later-prefix-traces" "Gate: CI checks grouped tile visits and split partials against BlockLayout and rejects corrupt partial boundaries" :later t)
     ("later-prefix-gate" "Gate: matched replay measures shared K/V bytes, peak allocation and end-to-end step time" :later t)
     ("later-quality" "A quality replay: landed cards run again and compared with a reference route" :later t)
     ("later-effort" "The lowest thinking effort that still lands cards, per kind of card" :later t)
     ("later-kv8" "The 8-bit cache, behind the quality replay" :later t)
     ("later-prune" "Far-key pruning on the full-attention passes, behind the quality replay" :later t)
     ("later-quant" "Smaller weight quantizations, behind the quality replay" :later t)
     ("later-grammar" "Tool calls constrained to valid JSON while sampling" :later t)
     ("later-gpu-sampling" "Sampling on the GPU" :later t)
     ("later-upstream" "General fixes sent upstream to inkling" :later t)
     ("later-best-of-n" "Best-of-N against the check: N attempts at one card in parallel lanes, landing the first whose check passes; gate on the tier test, land rate per tier for 1 attempt against best-of-4 on mas-bandwidth/sprint-corpus" :later t)
     ("later-aggregate" "Aggregation: N drafts and an aggregator lane that writes the combined fix, behind pro still missing the flash+ bar after best-of-N" :later t)
     ("later-critic" "Critic: a writer lane and a fresh-context critic lane, then a revision, behind pro still missing the flash+ bar after best-of-N" :later t)
     ("later-audit-split" "Split the largest core files (engine.rs, serve.rs, scheduler.rs, cache_scheduler.rs, spill.rs) behind the TLA trace checks, so each change stays reviewable" :later t)
     ("later-audit-deps" "Dependency hygiene in CI: cargo audit and Dependabot, so a vulnerable crate is caught without a human noticing" :later t)
     ("later-audit-bind" "Unauthenticated serving is loopback-only: warn loudly or refuse a non-loopback bind with no API key set" :later t)
     ("later-audit-fuzz" "Fuzz the GGUF loader, so a malformed model file cannot panic or corrupt the engine" :later t)
     ("later-audit-unwrap" "Request paths return errors instead of unwrapping, so bad input cannot abort the server (about 1546 unwrap and expect sites at the audit)" :later t)
     ("later-audit-contrib" "A contributor path for machines without an M5: what can be built and validated where, so outside changes are testable" :later t)
     ("later-audit-lint" "Checked rustfmt and clippy configuration in CI, so style survives team growth" :later t)
     ("later-audit-gpl" "One paragraph in the README on what GPL-3.0 means for embedding inky downstream" :later t)
   )
