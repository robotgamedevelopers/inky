  (:id "t-later-dspark" :type :task :title "Speculative decoding with Inkling's own DSpark drafter, exact verification: more tokens per cache read at long context" :state :doing :note "PR 15 lands the design (docs/DSPARK.md); PR 18 (per-row logits for a verify span) is open; acceptance on real card text being measured with llama.cpp PR 32218")
  (:id "t-later-m3" :type :task :title "The M3 Ultra tuning: decode steps on the non-tensor kernels" :state :todo)
  (:id "t-later-attention" :type :task :title "One attention kernel for every span, split over keys at positions fixed by the cache: decode spans near bus speed, bit-identical to prefill; gate on reference agreement, one reviewed golden rebaseline and bit-identical batch paths" :state :todo)
  (:id "t-later-fixed-cost" :type :task :title "A kernel for decode-size batches that reads each touched expert once at full bandwidth: up to 2x at 16 to 32 lanes" :state :todo)
  (:id "t-later-prefix-reads" :type :task :title "Grouped prefix reads match private fixed-split logits and goldens bit for bit" :state :todo)
  (:id "t-later-prefix-spec" :type :task :title "Shared-prefix design and measured overlap on four concurrent cards" :state :done :evidence ("docs/SHARED-PREFIX.md"))
  (:id "t-later-prefix-model" :type :task :title "Gate: TLC exhausts BlockLayout grouping and CacheScheduler ownership; each reversed witness fails" :state :todo)
  (:id "t-later-prefix-storage" :type :task :title "Gate for layer-3 blocks and tables: poisoned-slot forks reproduce private K/V bytes and CI validates ownership traces before storage locks" :state :todo)
  (:id "t-later-prefix-traces" :type :task :title "Gate: CI checks grouped tile visits and split partials against BlockLayout and rejects corrupt partial boundaries" :state :todo)
  (:id "t-later-prefix-gate" :type :task :title "Gate: matched replay measures shared K/V bytes, peak allocation and end-to-end step time" :state :todo)
  (:id "t-later-quality" :type :task :title "A quality replay: landed cards run again and compared with a reference route" :state :todo)
  (:id "t-later-effort" :type :task :title "The lowest thinking effort that still lands cards, per kind of card" :state :todo)
  (:id "t-later-kv8" :type :task :title "The 8-bit cache, behind the quality replay" :state :todo)
  (:id "t-later-prune" :type :task :title "Far-key pruning on the full-attention passes, behind the quality replay" :state :todo)
  (:id "t-later-quant" :type :task :title "Smaller weight quantizations, behind the quality replay" :state :todo)
  (:id "t-later-grammar" :type :task :title "Tool calls constrained to valid JSON while sampling" :state :todo)
  (:id "t-later-gpu-sampling" :type :task :title "Sampling on the GPU" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/73edddb502344b9c70024b8ff75bbf7f5c872871" "src/kernels.metal: k_gumbel, k_argmax1, k_argmax2" "src/engine.rs: encode_gumbel_solo, encode_gumbel_spans" "src/sampler.rs: Sampler::uses_gpu_gumbel" "src/serve.rs: scheduler" "https://github.com/robotgamedevelopers/inky/pull/64"))
  (:id "t-later-upstream" :type :task :title "General fixes sent upstream to inkling" :state :doing :note "Eriskii/erisinky pull request 2: the one-token batch fix and binv, open")
  (:id "t-later-best-of-n" :type :task :title "Best-of-N against the check: N attempts at one card in parallel lanes, landing the first whose check passes; gate on the tier test, land rate per tier for 1 attempt against best-of-4 on mas-bandwidth/sprint-corpus" :state :todo :note "The N attempts share one prompt through cross-lane prompt-prefix reuse (pull request 22). Depends on the flash+ provider goal and its tier test.")
  (:id "t-later-aggregate" :type :task :title "Aggregation: N drafts and an aggregator lane that writes the combined fix, behind pro still missing the flash+ bar after best-of-N" :state :todo :note "Starts only after later-best-of-n, and only if pro still misses the flash+ bar with best-of-N. The drafts share one prompt through cross-lane prompt-prefix reuse (pull request 22).")
  (:id "t-later-critic" :type :task :title "Critic: a writer lane and a fresh-context critic lane, then a revision, behind pro still missing the flash+ bar after best-of-N" :state :todo :note "Starts only after later-best-of-n, and only if pro still misses the flash+ bar with best-of-N.")
  (:id "t-later-audit-split" :type :task :title "Split the largest core files (engine.rs, serve.rs, scheduler.rs, cache_scheduler.rs, spill.rs) behind the TLA trace checks, so each change stays reviewable" :state :done :evidence ("src/engine/model.rs" "src/serve/messages.rs" "src/serve/prompt.rs" "src/serve/reply.rs" "src/scheduler/trace.rs" "src/cache_scheduler/walk.rs" "src/spill/store.rs" "scripts/check-tla.sh" "https://github.com/robotgamedevelopers/inky/pull/104") :note "The engine separates model loading, serving separates prompt rendering and API messages and replies, the scheduler separates trace generation, the cache scheduler separates its seeded walks, and spill separates durable storage. The trace tier runs MemMode, Blockbook, BlockLayout, reference scheduler, serving steps, and serving cache checks. The module split preserved the generated cache and scheduler trace bundles byte for byte.")
  (:id "t-later-audit-deps" :type :task :title "Dependency hygiene in CI: cargo audit and Dependabot, so a vulnerable crate is caught without a human noticing" :state :done :evidence (".github/workflows/dependency-audit.yml" ".github/dependabot.yml") :note "Cargo audit checks the committed lockfile on pull requests, main pushes, and weekly; Dependabot proposes Cargo and GitHub Actions updates weekly.")
  (:id "t-later-audit-bind" :type :task :title "Unauthenticated serving is loopback-only: warn loudly or refuse a non-loopback bind with no API key set" :state :done :evidence ("src/main.rs: parse_serve and cli_tests" "https://github.com/robotgamedevelopers/inky/pull/63") :note "The released CLI validates every resolved address and requires a key for non-loopback serving unless the operator requests an explicit override.")
  (:id "t-later-audit-fuzz" :type :task :title "Fuzz the GGUF loader, so a malformed model file cannot panic or corrupt the engine" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/dff0447f031092447249d567ce0c11cde3d8d496" "fuzz/Cargo.toml" "fuzz/fuzz_targets/gguf_load.rs" "src/gguf.rs: Gguf::open_bytes" "src/tokenizer.rs: Tokenizer::try_load" "https://github.com/robotgamedevelopers/inky/pull/113") :note "From the comprehensive audit (Aurora Muse, 2026-11-24, at be82ef3 v0.2.2): src/gguf.rs is the main untrusted-input surface and no fuzz targets were found.")
  (:id "t-later-audit-unwrap" :type :task :title "Request paths return errors instead of unwrapping, so bad input cannot abort the server (about 1546 unwrap and expect sites at the audit)" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/16ab36742ef87a268c0c9d8788bf5f1a79046305" "src/serve.rs" "src/main.rs" "src/session.rs" "src/tokenizer.rs" "src/record.rs" "https://github.com/robotgamedevelopers/inky/pull/118") :note "From the comprehensive audit (Aurora Muse, 2026-11-24, at be82ef3 v0.2.2): about 1546 unwrap and expect sites and 122 unsafe blocks in src; the release profile sets panic to abort, so a panic in a request path ends the server.")
  (:id "t-later-audit-contrib" :type :task :title "A contributor path for machines without an M5: what can be built and validated where, so outside changes are testable" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/dff0447f031092447249d567ce0c11cde3d8d496" "docs/CONTRIBUTING.md" "README.md" "https://github.com/robotgamedevelopers/inky/pull/113") :note "From the comprehensive audit (Aurora Muse, 2026-11-24, at be82ef3 v0.2.2): the decisive GPU gates run only on the self-hosted M5 runner, so external contributors cannot reproduce full CI.")
  (:id "t-later-audit-lint" :type :task :title "Checked rustfmt and clippy configuration in CI, so style survives team growth" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/16ab36742ef87a268c0c9d8788bf5f1a79046305" "rustfmt.toml" "clippy.toml" ".github/workflows/ci.yml" "https://github.com/robotgamedevelopers/inky/pull/118") :note "From the comprehensive audit (Aurora Muse, 2026-11-24, at be82ef3 v0.2.2): no rustfmt.toml, clippy.toml or deny.toml found; zero TODO and FIXME markers in src show the discipline is real but rests on convention.")
  (:id "t-later-audit-gpl" :type :task :title "One paragraph in the README on what GPL-3.0 means for embedding inky downstream" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/dff0447f031092447249d567ce0c11cde3d8d496" "README.md" "https://github.com/robotgamedevelopers/inky/pull/113") :note "From the comprehensive audit (Aurora Muse, 2026-11-24, at be82ef3 v0.2.2): licensing is clear (GPL-3.0-or-later, full LICENSE text) but the copyleft consequence for embedders is not stated where a downstream reader first lands.")
  (:id "t-later-audit-runner" :type :task :title "Dedicated isolated macOS user and sandbox for self-hosted M5 CI runners, separate from the owner login" :state :todo :note "From the unified 2026-11-24 audit synthesis (Rowan E1): self-hosted M5 GitHub Actions runners currently run under the owner account.")
  (:id "t-later-audit-actions-pin" :type :task :title "Pin every GitHub Action in CI workflows by full 40-hex commit SHA rather than mutable major tag" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/dff0447f031092447249d567ce0c11cde3d8d496" ".github/workflows/ci.yml" ".github/workflows/nightly.yml" ".github/workflows/release.yml" "tests/test_release_ci.py" "https://github.com/robotgamedevelopers/inky/pull/113") :note "From the unified 2026-11-24 audit synthesis (Rowan E19): Swatinem/rust-cache and actions/cache in ci.yml still use major tags.")
  (:id "t-later-audit-preauth-conn" :type :task :title "Short pre-authentication socket header deadline and separate unauthenticated connection budget on non-loopback binds" :state :done :evidence ("https://github.com/robotgamedevelopers/inky/commit/43fcc8c433972d494b5a8be10cb1c54e43294ff8" "src/serve.rs: PREAUTH_HEADER_TIMEOUT, MAX_UNAUTH_CONNS, UnauthConnGuard" "https://github.com/robotgamedevelopers/inky/pull/120") :note "From the unified 2026-11-24 audit synthesis (Rowan C3): connection slots are acquired before reading the Authorization header under a 60s per-read timeout.")
  (:id "t-later-audit-memd-reconnect" :type :task :title "Detect memd helper restart or reinstall in running serve processes and re-establish the wired-limit lease" :state :todo :note "From the unified 2026-11-24 audit synthesis (Rowan A5/D7): a memd restart restores the wired limit while existing serve processes continue without re-raising.")
