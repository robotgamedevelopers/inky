  (:id "audit-cache" :type :roadmap :title "Cache, admission and scheduler models"
   :rows (
     ("audit-cache-spill-identity" "P1 — Keep SSD checkpoint identities unique across restarts and concurrent opens ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-admission-warm" "P1 — Charge newly pinned Full and Window blocks before admitting a warm match ([#79](https://github.com/robotgamedevelopers/inky/pull/79))")
     ("audit-cache-physical-limits" "Apply physical KV row limits before accepting the request and size prefill spans to the Window pool ([#79](https://github.com/robotgamedevelopers/inky/pull/79))")
     ("audit-cache-admission-singleflight" "Reserve every distinct suffix with the lane that will prefill it ([#79](https://github.com/robotgamedevelopers/inky/pull/79))")
     ("audit-cache-spill-window" "P1 — Restore a long checkpoint and safely prefill a different continuation ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-spill-ownership" "Limit recovery cleanup to temporary files generated by Inky ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-spill-accounting" "Retain disk charges until deletion succeeds or absence is confirmed ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-spill-staging" "Reserve restore destinations and bound temporary KV memory ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-spill-progress" "Measure cold SSD restore latency and keep unrelated decoding responsive")
     ("audit-cache-prefix-storage" "Bound prefix metadata by peak occupancy and preserve stale-handle rejection ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-window-pruning" "Visit each expired window block once per lane ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-scheduler-trace" "Replay live scheduler burst and preemption decisions against their own specification ([#87](https://github.com/robotgamedevelopers/inky/pull/87))")
     ("audit-cache-ownership-trace" "Replay live paged-cache ownership through binds, releases, SSD restore and rollback")
     ("audit-cache-layout-runner" "Require a nonempty layout-model run on hosts without zsh ([#87](https://github.com/robotgamedevelopers/inky/pull/87))")
     ("audit-cache-prefix-nightly" "Run a tractable branching PrefixTree model and account for every scheduled check ([#87](https://github.com/robotgamedevelopers/inky/pull/87))")
     ("audit-cache-prefix-pins" "Model per-node pins separately from validity of a complete matched path ([#87](https://github.com/robotgamedevelopers/inky/pull/87))")
     ("audit-cache-spill-hardware" "Compare SSD-restored and cold generation on an M5 across eviction, restart and branching ([#78](https://github.com/robotgamedevelopers/inky/pull/78))")
     ("audit-cache-decode-reserve" "Reserve each request's real reply budget, or state the 4096 decode cap and the remaining livelock failure")
     ("audit-cache-pool-deferred" "Wake a pool-deferred lane when the holder can make progress, including before the first window prune")
   )
   :columns (("done" "done"))
