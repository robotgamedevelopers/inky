  (:id "revision" :type :roadmap :title "Design revision"
   :rows (
     ("rev-table" "The lane table corrected: the cache is read at about 210 GB/s and a lane reads all of it")
     ("rev-verify" "The four invariance and attention claims from the cold read measured")
     ("rev-startable" "Blocks: a prefix keeps the window blocks and recurrent state that make it a start point")
     ("rev-state" "Blocks: recurrent state kept at prompt ends, every 16 blocks and lane heads, not at every boundary")
     ("rev-offsets" "Blocks: 64-bit cache addressing through the block table")
     ("rev-admission" "Admission: the worst-case memory bound sets the lane limit")
     ("rev-cancel" "Scheduler: cancel during a step waits for the step")
     ("rev-parking" "Tiers: lazy spill of unreferenced blocks, an atomic reservation to restore, a bound for every waiting lane")
     ("rev-model" "Models: one coupled CacheScheduler model, exhaustive in TLC")
     ("rev-thinking" "Server: earlier turns rendered exactly as sent; no content-keyed map")
     ("rev-layers" "Layers 4 and 5 merged; a performance and memory gate inside layer 2")
     ("rev-gates" "Every layer's gate strengthened as the cold read lists")
     ("rev-attention" "Decode spans use split-K attention per lane; a many-lane attention kernel is the first follow-on")
   )
   :columns (("done" "done"))
   :cells (
     ("rev-table" "done" "t-rev-table")
