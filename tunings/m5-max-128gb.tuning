# Apple M5 Max MacBook Pro with 128 GB: the machine inky is tuned and measured on.
name = m5-max-128gb
chip = Apple M5 Max
memory_gb = 128
# GPU wired-memory limit in inky mode (MB): 128 GB less about 13 GB for macOS. Metal then recommends a 115.2 GiB working set.
wired_limit_mb = 118000
# kept free of lane caches inside Metal's working set (GiB)
lane_margin_gib = 4
# default lane count chosen from the Layer 6 replay sweep knee (max_ttft_p95_ms <= 20s)
default_lanes = 64
