# Apple M3 Ultra Mac Studio with 512 GB (80 GPU cores, 819 GB/s, Metal 3 simdgroup kernels, no MPP tensor_ops).
name = m3-ultra-512gb
chip = Apple M3 Ultra
memory_gb = 512
# GPU wired-memory limit in inky mode (MB): 512 GiB less 32 GiB for macOS (524288 - 32768).
wired_limit_mb = 491520
# kept free of lane caches inside Metal's working set (GiB): 4 GiB OS headroom
lane_margin_gib = 4
# 819 GB/s memory bandwidth with 512 GiB RAM: full 128-lane decode batch ceiling
default_lanes = 128
# Metal 3 simdgroup decode/prefill path (no M5 Neural Accelerators / MPP tensor_ops)
use_mpp = false
# Full/Window KV pool split: 15% Window (~69 GiB for 128 lanes + prefix starts) / 85% Full (~391 GiB)
kv_window_pct = 15
# 80 GPU cores: 16-way split-K target for non-tensor decode attention
decode_splits = 16
